# Arukone — 1Password reference template
#
# Used with: op run --env-file=.env.op -- <command>
# 1Password CLI resolves these references at execution time. Values are
# injected into the child process's environment only — never written to disk.
#
# This file IS committed (it contains no secrets, just references).
# The actual secret values live in 1Password.
#
# To use a different vault/account, fork this file as `.env.op.local`
# (gitignored) or override on the command line:
#   op run --account <name> --env-file=.env.op -- <command>

# References are of the form: op://<vault>/<item>/<field>
CLOUDFLARE_API_TOKEN="op://ALE-AUTOMATION/arukone-cloudflare/api_token"
CLOUDFLARE_ACCOUNT_ID="op://ALE-AUTOMATION/arukone-cloudflare/account_id"
CLOUDFLARE_WORKER_NAME=arukone
