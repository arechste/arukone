# Arukone — local deploy environment
#
# Copy to `.env` and fill in your values.
# `.env` is gitignored. Never commit secrets.
#
# Three ways to populate this file:
#   1. 1Password:    use `.env.op` instead and run `op run --env-file=.env.op -- <cmd>`
#   2. Manual:       copy this file to `.env` and paste values from the Cloudflare dashboard
#   3. Bring your own (sops, vault, doppler, ...): produce a populated `.env`
#
# See `docs/secret-management.md` for details.

# Cloudflare API token, scoped to "Workers Scripts: Edit" only.
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (find in the dashboard sidebar).
CLOUDFLARE_ACCOUNT_ID=

# Worker name (matches `name` in wrangler.jsonc; rarely needs to change).
CLOUDFLARE_WORKER_NAME=arukone
